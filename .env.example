DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///db.sqlite3

# --- Valeurs de référence pour un déploiement Render (config.settings.prod) ---
# DJANGO_SECRET_KEY=<clé générée, jamais la valeur de dev>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=votre-app.onrender.com
# DJANGO_SETTINGS_MODULE=config.settings.prod
# CORS_ALLOWED_ORIGINS=https://votre-frontend.example.com
# CSRF_TRUSTED_ORIGINS=https://votre-frontend.example.com,https://votre-app.onrender.com
# DATABASE_URL=<Internal Database URL fournie par Render Postgres>
